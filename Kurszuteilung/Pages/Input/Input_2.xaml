<Page x:Class="Kurszuteilung.Pages.Input.Input_2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kurszuteilung.Pages.Input"
      mc:Ignorable="d" 
      d:DesignHeight="444"
      d:DesignWidth="450"
      Title="Help_2">

    <Border Background="{StaticResource Brush_Layer3}">
        <Grid>
            <Grid.RowDefinitions>

                <!--Content-->
                <RowDefinition Height="131*" />
                <RowDefinition Height="20*" />

                <!--Fill Row-->
                <RowDefinition Height="293*" />
            </Grid.RowDefinitions>

            <!--Explaining Image-->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="11"
                    CornerRadius="10"
                    Background="{StaticResource Brush_Layer3}"
                    BorderThickness="4"
                    BorderBrush="{StaticResource Brush_Accent1}">

                <Grid Margin="5">
                    <Grid.RowDefinitions>

                        <!--Output Path-->
                        <RowDefinition Height="30" />
                        <RowDefinition Height="35*" />
                        <RowDefinition Height="35*" />

                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!--Output Path-->
                    <!--Explaining-->
                    <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Text="Ziel-Excel Datei"
                           Style="{StaticResource Font_ButtonHeader}"
                           VerticalAlignment="Center"
                           Margin="9, 2, 0, 0" />

                    <!--New File-->
                    <!--Button Enabled-->
                    <Button Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Stretch"
                        Visibility="Visible"
                        Margin="2"
                        Style="{StaticResource Style_ButtonAccent1}"
                        Foreground="White"
                        FontFamily="Microsoft YaHei UI"
                        x:Name="Button_CreateNewFileEnabled">

                        <StackPanel>
                            <TextBlock Text="Neue Datei Erstellen"
                                   Style="{StaticResource Font_ButtonText}"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--Button Disabled-->
                    <Button Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Visibility="Collapsed"
                        VerticalAlignment="Stretch"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        Foreground="White"
                        FontFamily="Microsoft YaHei UI"
                        Click="Click_CreateNewFileDisabled"
                        x:Name="Button_CreateNewFileDisabled">

                        <StackPanel>
                            <TextBlock Text="Neue Datei Erstellen"
                                   Style="{StaticResource Font_ButtonText}"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--Existing File-->
                    <!--Button Enabled-->
                    <Button Grid.Row="1"
                        Grid.Column="3"
                        Grid.ColumnSpan="3"
                        Visibility="Collapsed"
                        Margin="2"
                        Style="{StaticResource Style_ButtonAccent1}"
                        Foreground="White"
                        FontFamily="Microsoft YaHei UI"
                        x:Name="Button_UseExistingFileEnabled">

                        <StackPanel>
                            <TextBlock Text="Existierende Verwenden"
                                   Style="{StaticResource Font_ButtonText}"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--Button Disabled-->
                    <Button Grid.Row="1"
                        Grid.Column="3"
                        Grid.ColumnSpan="3"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        Foreground="White"
                        FontFamily="Microsoft YaHei UI"
                        Click="Click_UseExistingFileDisabled"
                        x:Name="Button_UseExistingFileDisabled">

                        <StackPanel>
                            <TextBlock Text="Existierende Verwenden"
                                   Style="{StaticResource Font_ButtonText}"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--Open Explorer Buttons-->
                    <!--New File-->
                    <Button Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer6}"
                        Foreground="White"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        FontFamily="Microsoft YaHei UI"
                        Click="Click_OutputFileNew"
                        x:Name="Button_OutputFileNew">

                        <StackPanel>
                            <TextBlock Text="Klicken zum Auswählen"
                                   Style="{StaticResource Font_ButtonText}"
                                   x:Name="TextBlock_NewFile"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--Existing File-->
                    <Button Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="6"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer6}"
                        Foreground="White"
                        Visibility="Collapsed"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        FontFamily="Microsoft YaHei UI"
                        Click="Click_OutputFileExisting"
                        x:Name="Button_OutputFileExisting">

                        <StackPanel>
                            <TextBlock Text="Klicken zum Auswählen"
                                   Style="{StaticResource Font_ButtonText}"
                                   x:Name="TextBlock_ExistingFile"
                                   HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Visible"
                          Style="{StaticResource Style_ScrollViewerLayer5}">

                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="11">

                    <!--Explaining Texts-->
                    <!--General-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Visibility="Visible"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               LineStackingStrategy="BlockLineHeight"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0">
    
                        <Run Text="Hier wird die" />
                        <Run Text="Excel Datei"
                             Foreground="#0091e6"
                             FontWeight="Bold" />
                        <Run Text="angegeben, in die alle verarbeiteten Daten gespeichert werden sollen." />
                    </TextBlock>

                    <!--New File-->
                    <!--Header-->
                    <TextBlock Grid.Row="2"
                               LineHeight="22"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               Text="Neue Datei erstellen:"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingHeader}"
                               VerticalAlignment="Top"
                               Margin="5, 15, 5, 0" />

                    <!--General-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 0, 5, 0">
    
                        <Run Text="Hier wird der Speicherort und der Dateiname einer neuen Excel Datei angegeben." />
                    </TextBlock>

                    <!--Existing File-->
                    <!--Header-->
                    <TextBlock Grid.Row="2"
                               LineHeight="22"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               Text="Existierende Verwenden:"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingHeader}"
                               VerticalAlignment="Top"
                               Margin="5, 20, 5, 0" />

                    <!--General-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 0, 5, 0">
    
                        <Run Text="Hier wird eine bereits existierende Excel Datei angegeben." />
                    </TextBlock>

                    <!--Error--><!--
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 10, 5, 0"
                               x:Name="TextBlock_Error">
                    </TextBlock>-->
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
