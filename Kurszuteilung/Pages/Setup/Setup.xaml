<Page x:Class="Kurszuteilung.Pages.Setup.Setup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kurszuteilung.Pages.Setup"
      mc:Ignorable="d" 
      d:DesignHeight="600"
      d:DesignWidth="450"
      Title="Setup">

    <Border Background="{StaticResource Brush_Layer3}">

        <!--AllUse Grid-->
        <Grid Margin="5">

            <!--Main Grid-->
            <Grid>
                <Grid.RowDefinitions>

                    <!--Header-->
                    <RowDefinition Height="50" />

                    <!--Frame-->
                    <RowDefinition Height="350*" />

                    <!--Navigate Buttons-->
                    <RowDefinition Height="35*" />

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Header-->
                <!--Menu Button-->
                <Button Grid.Row="0"
                        Grid.Column="0"                        
                        Width="46"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource Style_ButtonLayer3_5}"
                        Click="Click_Menu">

                    <StackPanel>
                        <Image Source="/Icons/menu.png"
                               Height="25"
                               Width="25" />
                    </StackPanel>
                </Button>

                <!--Title-->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Text="Quell-Excel-Datei Einrichten"
                           Margin="55, 0, 0, 0"                           
                           Style="{StaticResource Font_MenuHeader}"
                           VerticalAlignment="Center" />

                <!--Frame-->
                <Frame Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="6"
                       Source="/Pages/Setup/Setup_1.xaml"
                       x:Name="Frame_Help"
                       NavigationUIVisibility="Hidden"
                       Margin="5"/>

                <!--Navigate-->
                <!--Left Button-->
                <Button Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Stretch"
                        Visibility="Visible"
                        Click="Click_Left"
                        Margin="2"
                        Style="{StaticResource Style_ButtonAccent1}"
                        Foreground="White">

                    <StackPanel>
                        <Image Source="/Icons/left.png"
                               Height="25"
                               Width="25" />
                    </StackPanel>
                </Button>

                <!--Right Button-->
                <Button Grid.Row="2"
                        Grid.Column="3"
                        Grid.ColumnSpan="3"
                        VerticalAlignment="Stretch"
                        Visibility="Visible"
                        Click="Click_Right"
                        Margin="2"
                        Style="{StaticResource Style_ButtonAccent1}"
                        Foreground="White">

                    <StackPanel>
                        <Image Source="/Icons/right.png"
                               Height="25"
                               Width="25" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Page>
