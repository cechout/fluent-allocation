<Page x:Class="Kurszuteilung.Pages.Setup.Setup_1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kurszuteilung.Pages.Setup"
      mc:Ignorable="d" 
      d:DesignHeight="444"
      d:DesignWidth="450"
      Title="Setup_1">

    <Border Background="{StaticResource Brush_Layer3}">
        <Grid>
            <Grid.RowDefinitions>

                <!--Content-->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20*" />

                <!--Fill Row-->
                <RowDefinition Height="304*" />

            </Grid.RowDefinitions>

            <!--Explaining Image-->
            <Border Grid.Row="0"
                    CornerRadius="10"
                    Background="{StaticResource Brush_Layer3}"
                    BorderThickness="4"
                    BorderBrush="{StaticResource Brush_Accent1}">

                <Image HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Source="/Images/Setup/sheets.png"
                       Stretch="Uniform"/>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Visible"
                          Style="{StaticResource Style_ScrollViewerLayer5}">
                
                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="11">

                    <!--Explaining Texts-->
                    <!--Header-->
                    <TextBlock Grid.Row="2"
                           LineHeight="18"
                           Grid.RowSpan="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="11"
                           TextWrapping="Wrap"
                           Style="{StaticResource Font_TextBlockExplainingGuideline}"
                           VerticalAlignment="Top"
                           Margin="5, 5, 5, 0">

                    <Run Text="Die Excel Datei muss 2 Blätter beinhalten." />
                    </TextBlock>

                    <!--General-->
                    <TextBlock Grid.Row="2"
                           LineHeight="18"
                           Grid.RowSpan="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="11"
                           TextWrapping="Wrap"
                           Style="{StaticResource Font_TextBlockExplainingText}"
                           VerticalAlignment="Top"
                           Margin="5, 10, 0, 0">
        
                    <Run Text="Auf Blatt 1 werden die Daten der" />
                    <Run Text="Schüler"
                         FontWeight="DemiBold"
                         Foreground="{StaticResource Brush_Accent1}" />            
                    <Run Text="eingetragen." />            
                    <LineBreak />
                    
                    <Run Text="Auf Blatt 2 werden die Daten der" />
                    <Run Text="Fächer"
                         FontWeight="DemiBold"
                         Foreground="{StaticResource Brush_Accent1}" />            
                    <Run Text="eingetragen." />
                    </TextBlock>

                    <!--Note-->
                    <TextBlock Grid.Row="2"
                           LineHeight="18"
                           Grid.RowSpan="1"
                           Grid.Column="1"
                           Grid.ColumnSpan="11"
                           TextWrapping="Wrap"
                           Style="{StaticResource Font_TextBlockExplainingNote}"
                           VerticalAlignment="Top"
                           Margin="5, 20, 0, 0">
            
                    <Run Text="Hinweis:" />
                    <LineBreak />
                
                    <Run Text="Die Wahl der Blattbezeichnungen spielt keine Rolle." />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
