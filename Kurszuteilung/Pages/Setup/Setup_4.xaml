<Page x:Class="Kurszuteilung.Pages.Setup.Setup_4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kurszuteilung.Pages.Setup"
      mc:Ignorable="d" 
      d:DesignHeight="444"
      d:DesignWidth="450"
      Title="Setup_4">

    <Border Background="{StaticResource Brush_Layer3}">
        <Grid>
            <Grid.RowDefinitions>

                <!--Content-->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20*" />

                <!--Fill Row-->
                <RowDefinition Height="249*" />

            </Grid.RowDefinitions>

            <!--Explaining Image-->
            <Border Grid.Row="0"
                    CornerRadius="10"
                    Background="{StaticResource Brush_Layer3}"
                    BorderThickness="4"
                    BorderBrush="{StaticResource Brush_Accent1}">

                <Image HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       Source="/Images/Setup/inputUsers.png"
                       Stretch="Uniform" />
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Visible"
                          Style="{StaticResource Style_ScrollViewerLayer5}">

                <StackPanel>

                    <!--Explaining Texts-->
                    <!--Header-->
                    <TextBlock Grid.Row="2"
                               LineHeight="22"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               Text="1. Blatt (Erklärung + Beispiel)"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingHeader}"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0" />

                    <!--Id-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0">

                        <Run Text="Id:"
                             Foreground="{StaticResource Brush_Accent3}"
                             FontWeight="Bold" />
                        <Run Text="Eine" />
                        <Run Text="eindeutig"
                             Foreground="{StaticResource Brush_Accent1}"
                             FontWeight="Bold" />
                        <Run Text="zuordenbare Nummer. (Es können Nummern übersprungen werden)" />
                    </TextBlock>

                    <!--Name-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0">

                        <Run Text="Name:"
                             Foreground="{StaticResource Brush_Accent3}"
                             FontWeight="Bold" />
                        <Run Text="Der Name des Schülers. (Hat keine Auswirkungen auf das Program)" />
                    </TextBlock>

                    <!--Attributes-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0">

                        <Run Text="Attribute:"
                             Foreground="{StaticResource Brush_Accent2}"
                             FontWeight="Bold" />
                        <Run Text="Kann beispielsweise die Klasse, oder das Alter eines Schülers sein." />
                    </TextBlock>

                    <!--Priorities-->
                    <TextBlock Grid.Row="2"
                               LineHeight="18"
                               Grid.RowSpan="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource Font_TextBlockExplainingText}"
                               VerticalAlignment="Top"
                               Margin="5, 5, 5, 0">

                        <Run Text="Prioritäten:"
                             Foreground="{StaticResource Brush_Accent3}"
                             FontWeight="Bold" />
                        <Run Text="Jeder Schüler hat seine bevorzugten Fächer, die er gerne haben möchte. Diese werden Fächer werden in Form der" />
                        <Run Text="Fach Id"
                             Foreground="{StaticResource Brush_Accent1}"
                             FontWeight="Bold" />
                        <Run Text="in absteigender Reihenfolge als Priorität 1, Priorität 2 etc... eingetragen." />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
