    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Database\main_database.mdf" />
    <None Remove="Database\main_database_log.ldf" />
    <None Remove="Icons\add.png" />
    <None Remove="Icons\database.png" />
    <None Remove="Icons\done.png" />
    <None Remove="Icons\help.png" />
    <None Remove="Icons\Icon1.ico" />
    <None Remove="Icons\Icon2.png" />
    <None Remove="Icons\Icon3.png" />
    <None Remove="Icons\Icon4.ico" />
    <None Remove="Icons\Icon5.ico" />
    <None Remove="Icons\icon6.ico" />
    <None Remove="Icons\info.png" />
    <None Remove="Icons\left.png" />
    <None Remove="Icons\menu.png" />
    <None Remove="Icons\right.png" />
    <None Remove="Icons\settings.png" />
    <None Remove="Icons\sub.png" />
    <None Remove="Images\Input\confirm.png" />
    <None Remove="Images\Input\groupBy.png" />
    <None Remove="Images\Input\nrOfEverything.png" />
    <None Remove="Images\Input\savePath.png" />
