    <None Remove="Images\Setup\inputSubjects.png" />
    <None Remove="Images\Setup\inputUsers.png" />
    <None Remove="Images\Setup\sheets.png" />
  </ItemGroup>

  <!--
    excel comes in as the primary interop assembly from nuget instead of a COMReference, which only the
    visual studio msbuild can resolve (MSB4803 on dotnet build) and only on a machine with office installed
    the types stay embedded the way the COMReference had them; the code relies on that, because only an
    embedded interop type hands a cell back as dynamic
  -->
  <Target Name="EmbedExcelInteropTypes" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)' == 'Microsoft.Office.Interop.Excel'">
        <EmbedInteropTypes>true</EmbedInteropTypes>
      </ReferencePath>
    </ItemGroup>
  </Target>

  <!--
    the database is copied once and then left alone: localdb keeps the copy attached for a while after a run,
    so overwriting it on every build fails while the file is locked, and a replaced file under a still
    attached name is refused on the next attach; every run wipes the tables anyway
  -->
  <ItemGroup>
    <Content Include="Database\main_database.mdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Database\main_database_log.ldf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\add.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\database.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\done.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\help.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\Icon1.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Icons\Icon2.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
