<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentAllocation.Views.InputHelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:FluentAllocation.Views"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  page header  -->
        <!--  (the left margin clears the navigation views hamburger button)  -->
        <Grid
            Grid.Row="0"
            Height="38"
            Margin="49,4,4,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{ThemeResource SubtitleTextBlockStyle}"
                Text="Input" />
        </Grid>

        <!--  steps  -->
        <!--
            one at a time, each the field of the allocation form over its explanation, as in version 1;
            the field is the real control, looking live but out of reach of the pointer, the keyboard and
            a screen reader
        -->
        <Grid Grid.Row="1" Padding="8">

            <!--  step 1: the source workbook  -->
            <Grid Visibility="{x:Bind local:HelpSteps.Show(ViewModel.CurrentStep, 0), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                    <TextBlock
                        Margin="4,4,0,6"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Source Workbook" />
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" Glyph="&#xE74E;" />
                            <TextBlock Grid.Column="1" Text="Click to choose" />
                        </Grid>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel Margin="4,0" Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Here you choose the" />
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="source workbook" /><Run Text=", which holds all the data to allocate." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Text="Help with setting up the source workbook:" />
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Menu &gt; Help &gt; Source Workbook" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  step 2: the result workbook  -->
            <Grid Visibility="{x:Bind local:HelpSteps.Show(ViewModel.CurrentStep, 1), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                    <TextBlock
                        Margin="4,4,0,6"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Result Workbook" />
                    <controls:Segmented
                        Margin="0,0,0,5"
                        HorizontalAlignment="Stretch"
                        IsTabStop="False"
                        SelectedIndex="0">
                        <controls:SegmentedItem Content="New File" IsTabStop="False" />
                        <controls:SegmentedItem Content="Existing File" IsTabStop="False" />
                    </controls:Segmented>
                    <Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="16" Glyph="&#xE74E;" />
                            <TextBlock Grid.Column="1" Text="Click to choose" />
                        </Grid>
                    </Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel Margin="4,0" Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Here you choose the" />
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="workbook" />
                            <Run Text="the result is saved to." />
                        </TextBlock>
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="New File" />
                        <TextBlock TextWrapping="Wrap" Text="Choose the folder and the name of a new workbook." />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            Text="Existing File" />
                        <TextBlock TextWrapping="Wrap" Text="Choose a workbook that already exists. Everything in it is replaced by the result." />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  step 3: the counts  -->
            <Grid Visibility="{x:Bind local:HelpSteps.Show(ViewModel.CurrentStep, 2), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    AutomationProperties.AccessibilityView="Raw"
                    ColumnSpacing="4"
                    IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="4,4,4,6"
                        Text="Participants" />
                    <NumberBox
                        Grid.Row="1"
                        Grid.Column="0"
                        IsTabStop="False"
                        SpinButtonPlacementMode="Inline"
                        Value="100" />
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="4,4,0,6"
                        Text="Options" />
                    <NumberBox
                        Grid.Row="1"
                        Grid.Column="1"
                        IsTabStop="False"
                        SpinButtonPlacementMode="Inline"
                        Value="8" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="4,8,4,6"
                        Text="Attributes" />
                    <NumberBox
                        Grid.Row="3"
                        Grid.Column="0"
                        IsTabStop="False"
                        SpinButtonPlacementMode="Inline"
                        Value="1" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="4,8,0,6"
                        Text="Priorities" />
                    <NumberBox
                        Grid.Row="3"
                        Grid.Column="1"
                        IsTabStop="False"
                        SpinButtonPlacementMode="Inline"
                        Value="4" />
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="4,8,4,6"
                        Text="Options per Participant" />
                    <NumberBox
                        Grid.Row="5"
                        Grid.Column="0"
                        IsTabStop="False"
                        SpinButtonPlacementMode="Inline"
                        Value="2" />
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel Margin="4,0" Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Here you enter the" />
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="number" />
                            <Run Text="of each, exactly as the source workbook holds them." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Text="With 100 participants, for example, enter 100." />
                        <TextBlock TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Options per Participant" />
                            <Run Text="is how many options every participant should end up with." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!--  step 4: grouping  -->
            <Grid Visibility="{x:Bind local:HelpSteps.Show(ViewModel.CurrentStep, 3), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                    <TextBlock
                        Margin="4,4,0,6"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Group by Attribute" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            MinWidth="0"
                            IsChecked="True"
                            IsTabStop="False" />
                        <TextBox
                            Grid.Column="1"
                            IsTabStop="False"
                            Text="Department" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel Margin="4,0" Spacing="8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Here you decide whether the participants are also grouped by an" />
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="attribute" />
                            <Run Text="on a sheet of their own." />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Enter the" />
                            <Run FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="name" />
                            <Run Text="of the attribute in the box, as its header in the source workbook reads." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!--  back, the steps, next  -->
        <Grid
            Grid.Row="2"
            Padding="8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                AutomationProperties.Name="Back"
                Command="{x:Bind ViewModel.BackCommand}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="16" Glyph="&#xE76B;" />
            </Button>
            <PipsPager
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Step"
                NumberOfPages="{x:Bind ViewModel.StepCount}"
                SelectedPageIndex="{x:Bind ViewModel.CurrentStep, Mode=TwoWay}" />
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Next"
                Command="{x:Bind ViewModel.NextCommand}"
                ToolTipService.ToolTip="Next">
                <FontIcon FontSize="16" Glyph="&#xE76C;" />
            </Button>
        </Grid>
    </Grid>
</Page>
