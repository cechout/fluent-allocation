<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentAllocation.Controls.SheetPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FluentAllocation.Controls">

    <!--
        one template per kind of cell, so every brush is a theme resource and follows a theme switch;
        the code behind only places them in the grid
    -->
    <UserControl.Resources>
        <!--  the column letters, the row numbers and the corner between them  -->
        <DataTemplate x:Key="FrameCell" x:DataType="local:SheetCell">
            <Border
                Padding="6,2"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}" />
            </Border>
        </DataTemplate>

        <!--  a header the workbook must have  -->
        <DataTemplate x:Key="RequiredCell" x:DataType="local:SheetCell">
            <Border
                Padding="6,2"
                Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}" />
            </Border>
        </DataTemplate>

        <!--  a header the workbook may leave out  -->
        <DataTemplate x:Key="OptionalCell" x:DataType="local:SheetCell">
            <Border
                Padding="6,2"
                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}" />
            </Border>
        </DataTemplate>

        <!--  a value; numbers sit on the right, as Excel puts them  -->
        <DataTemplate x:Key="TextCell" x:DataType="local:SheetCell">
            <Border
                Padding="6,2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Text="{x:Bind Text}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NumberCell" x:DataType="local:SheetCell">
            <Border
                Padding="6,2"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,1">
                <TextBlock
                    HorizontalAlignment="Right"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{x:Bind Text}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1,1,0,0"
        CornerRadius="4">
        <Grid x:Name="CellGrid" />
    </Border>
</UserControl>
