<Page x:Class="Kurszuteilung.Pages.Menu.Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kurszuteilung.Pages.Menu"
      mc:Ignorable="d" 
      d:DesignHeight="600"
      d:DesignWidth="450"
      Title="Menu">

    <Border Background="{StaticResource Brush_Layer3}">

        <!--AllUse Grid-->
        <Grid Margin="5">

            <!--Main Grid-->
            <Grid>
                <Grid.RowDefinitions>

                    <!--Header-->
                    <RowDefinition Height="50" />
                    <RowDefinition Height="10*" />

                    <!--Navigate Buttons-->
                    <RowDefinition Height="30" />
                    <RowDefinition Height="43" />
                    <RowDefinition Height="10*" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="43" />
                    <RowDefinition Height="43" />

                    <!--Fill Row-->
                    <RowDefinition Height="250*" />

                    <!--Bottom-->
                    <RowDefinition Height="43" />

                </Grid.RowDefinitions>

                <!--Header-->
                <!--Menu Button-->
                <Button Grid.Row="0"
                        Grid.Column="0"                        
                        Width="46"
                        Margin="2"
                        HorizontalAlignment="Left"
                        Style="{DynamicResource Style_ButtonLayer3_5}"
                        Click="Click_Menu">

                    <StackPanel>
                        <Image Source="/Icons/menu.png"
                               Height="25"
                               Width="25" />
                    </StackPanel>
                </Button>

                <!--Title-->
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="6"
                           Text="Menü"
                           Margin="55, 0, 0, 0"                           
                           Style="{StaticResource Font_MenuHeader}"
                           VerticalAlignment="Center" />

                <!--Navigate Buttons-->
                <!--Standard-->
                <!--Explaining-->
                <TextBlock Grid.Row="2"
                           Text="Allgemein"
                           Foreground="LightGray"
                           Style="{StaticResource Font_ButtonHeader}"
                           VerticalAlignment="Center"
                           Margin="9, 2, 0, 0" />

                <!--Button Selected-->
                <Button Grid.Row="3"
                        Click="Click_Menu"
                        Visibility="Visible"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button1_Standard">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#00a3ff"
                                CornerRadius="2" />

                        <Image Source="/Icons/database.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Auswertung"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Button Unselected-->
                <Button Grid.Row="3"
                        Visibility="Collapsed"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer3_5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button2_Standard"
                        Click="Click_Standard">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                CornerRadius="2" />

                        <Image Source="/Icons/database.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Auswertung"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Help-->
                <!--Explaining-->
                <TextBlock Grid.Row="5"
                           Text="Hilfe"
                           Foreground="LightGray"
                           Style="{StaticResource Font_ButtonHeader}"
                           VerticalAlignment="Center"
                           Margin="9, 2, 0, 0" />

                <!--Setup Source Excel File-->
                <!--Button Selected-->
                <Button Grid.Row="6"
                        Click="Click_Menu"
                        Visibility="Collapsed"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button1_Setup">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#00a3ff"
                                CornerRadius="2" />

                        <Image Source="/Icons/help.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Excel Datei Einrichten"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Button Unselected-->
                <Button Grid.Row="6"
                        Visibility="Visible"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer3_5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button2_Setup"
                        Click="Click_Setup">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                CornerRadius="2" />

                        <Image Source="/Icons/help.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Quell-Excel-Datei Einrichten"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Input-->
                <!--Button Selected-->
                <Button Grid.Row="7"
                        Click="Click_Menu"
                        Visibility="Collapsed"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button1_Input">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#00a3ff"
                                CornerRadius="2" />

                        <Image Source="/Icons/help.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Eingabe"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Button Unselected-->
                <Button Grid.Row="7"
                        Visibility="Visible"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer3_5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button2_Input"
                        Click="Click_Input">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                CornerRadius="2" />

                        <Image Source="/Icons/help.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Eingabe"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Imprint-->
                <!--Button Selected-->
                <Button Grid.Row="9"
                        Click="Click_Menu"
                        Visibility="Collapsed"
                        Margin="2"
                        Style="{StaticResource Style_ButtonLayer5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button1_Imprint">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="#00a3ff"
                                CornerRadius="2" />

                        <Image Source="/Icons/info.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Info"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!--Button Unselected-->
                <Button Grid.Row="9"
                        Margin="2"
                        Visibility="Visible"
                        Style="{StaticResource Style_ButtonLayer3_5}"
                        HorizontalContentAlignment="Left"
                        x:Name="Button2_Imprint"
                        Click="Click_Imprint">

                    <StackPanel Orientation="Horizontal">
                        <Border Height="20"
                                Width="5"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                CornerRadius="2" />

                        <Image Source="/Icons/info.png"
                               HorizontalAlignment="Left"
                               Margin="7, 0, 0, 0"
                               Height="22"
                               Width="22" />

                        <TextBlock Text="Info"
                                   Margin="13, 0, 0, 0"
                                   Style="{StaticResource Font_ButtonText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Page>
